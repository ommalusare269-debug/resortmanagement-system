generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  CustomerID   Int        @id @default(autoincrement())
  Name         String     @db.VarChar(100)
  Phone        String     @db.VarChar(15)
  Email        String     @unique @db.VarChar(100)
  Address      String?    @db.VarChar(255)
  PasswordHash String     @db.VarChar(255)
  CreatedAt    DateTime?  @default(now()) @db.DateTime(0)
  Bookings     Booking[]

  @@map("CUSTOMERS")
}

model RoomType {
  RoomTypeID  Int     @id @default(autoincrement())
  TypeName    String  @db.VarChar(50)
  Description String? @db.VarChar(255)
  Capacity    Int
  Rate        Decimal @db.Decimal(10, 2)
  Rooms       Room[]

  @@map("ROOM_TYPES")
}

model Room {
  RoomID         Int               @id @default(autoincrement())
  RoomTypeID     Int
  RoomNo         String            @unique @db.VarChar(10)
  FloorNo        Int?
  Status         String            @db.VarChar(20)
  CleaningStatus String            @default("Clean") @db.VarChar(20)
  RoomType       RoomType          @relation(fields: [RoomTypeID], references: [RoomTypeID], onDelete: Restrict, onUpdate: Restrict)
  RoomAllocations RoomAllocation[]

  @@index([RoomTypeID], map: "RoomTypeID")
  @@map("ROOMS")
}

model Booking {
  BookingID       Int               @id @default(autoincrement())
  CustomerID      Int
  CheckInDate     DateTime          @db.Date
  CheckOutDate    DateTime          @db.Date
  NoOfGuests      Int
  BookingDate     DateTime?         @default(now()) @db.DateTime(0)
  Status          String            @db.VarChar(20)
  Customer        Customer          @relation(fields: [CustomerID], references: [CustomerID], onDelete: Restrict, onUpdate: Restrict)
  BookingServices BookingService[]
  Invoices        Invoice[]
  RoomAllocations RoomAllocation[]

  @@index([CustomerID], map: "CustomerID")
  @@map("BOOKINGS")
}

model RoomAllocation {
  AllocationID Int      @id @default(autoincrement())
  BookingID    Int
  RoomID       Int
  CheckInDate  DateTime @db.Date
  CheckOutDate DateTime @db.Date
  Rate         Decimal  @db.Decimal(10, 2)
  Booking      Booking  @relation(fields: [BookingID], references: [BookingID], onDelete: Cascade, onUpdate: Restrict)
  Room         Room     @relation(fields: [RoomID], references: [RoomID], onDelete: Restrict, onUpdate: Restrict)

  @@index([BookingID], map: "BookingID")
  @@index([RoomID], map: "RoomID")
  @@map("ROOM_ALLOCATIONS")
}

model Service {
  ServiceID       Int              @id @default(autoincrement())
  ServiceName     String           @db.VarChar(100)
  Description     String?          @db.VarChar(255)
  Charge          Decimal          @db.Decimal(10, 2)
  BookingServices BookingService[]

  @@map("SERVICES")
}

model BookingService {
  BookingServiceID Int     @id @default(autoincrement())
  BookingID        Int
  ServiceID        Int
  Qty              Int
  Amount           Decimal @db.Decimal(10, 2)
  Status           String  @default("Pending") @db.VarChar(20)
  Booking          Booking @relation(fields: [BookingID], references: [BookingID], onDelete: Cascade, onUpdate: Restrict)
  Service          Service @relation(fields: [ServiceID], references: [ServiceID], onDelete: Restrict, onUpdate: Restrict)

  @@index([BookingID], map: "BookingID")
  @@index([ServiceID], map: "ServiceID")
  @@map("BOOKING_SERVICES")
}

model Staff {
  StaffID      Int          @id @default(autoincrement())
  Name         String       @db.VarChar(100)
  Role         String       @db.VarChar(50)
  Department   String?      @db.VarChar(100)
  Phone        String       @db.VarChar(15)
  Email        String       @unique @db.VarChar(100)
  PasswordHash String       @db.VarChar(255)
  Salary       Decimal      @db.Decimal(10, 2)
  Attendances  Attendance[]

  @@map("STAFF")
}

model Attendance {
  AttendanceID Int      @id @default(autoincrement())
  StaffID      Int
  Date         DateTime @db.Date
  Status       String   @db.VarChar(50)
  Staff        Staff    @relation(fields: [StaffID], references: [StaffID], onDelete: Cascade, onUpdate: Restrict)

  @@unique([StaffID, Date])
  @@index([StaffID], map: "StaffID")
  @@map("ATTENDANCE")
}

model Invoice {
  InvoiceID   Int       @id @default(autoincrement())
  BookingID   Int
  InvoiceDate DateTime  @db.Date
  TotalAmount Decimal   @db.Decimal(12, 2)
  Discount    Decimal?  @default(0.00) @db.Decimal(10, 2)
  GrandTotal  Decimal   @db.Decimal(12, 2)
  Booking     Booking   @relation(fields: [BookingID], references: [BookingID], onDelete: Cascade, onUpdate: Restrict)
  Payments    Payment[]

  @@index([BookingID], map: "BookingID")
  @@map("INVOICES")
}

model Payment {
  PaymentID    Int      @id @default(autoincrement())
  InvoiceID    Int
  PaymentDate  DateTime @db.Date
  Amount       Decimal  @db.Decimal(12, 2)
  PaymentMode  String   @db.VarChar(50)
  TxnReference String?  @db.VarChar(100)
  Status       String   @db.VarChar(20)
  Invoice      Invoice  @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade, onUpdate: Restrict)

  @@index([InvoiceID], map: "InvoiceID")
  @@map("PAYMENTS")
}

model Setting {
  Key   String @id @db.VarChar(100)
  Value String @db.Text

  @@map("SETTINGS")
}
